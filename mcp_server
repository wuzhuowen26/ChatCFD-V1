class FileStructureResult(TypedDict):
    """Result structure for GetOpenFOAMCaseFileStructure tool."""
    status: str
    message: str
    file_structure: Dict[str, Any]

@mcp.tool()
def get_openfoam_case_file_structure(
    case_path: Path,
    max_depth: int = 3
) -> FileStructureResult:
    """
    Generates a dictionary representing the file and directory structure
    of an OpenFOAM case up to a specified depth.

    Args:
        case_path (Path): The root path of the OpenFOAM case directory.
        max_depth (int): The maximum depth to traverse for the file structure.

    Returns:
        FileStructureResult: A dictionary containing the status, a message,
                             and the file structure as a nested dictionary.
                             Directories are keys pointing to nested dicts,
                             files are keys pointing to 'file' string.
    """
    if not case_path.is_dir():
        logging.error(f"Case path '{case_path}' does not exist or is not a directory.")
        return {
            "status": "failure",
            "message": f"Case path '{case_path}' does not exist or is not a directory.",
            "file_structure": {}
        }

    def _get_structure(current_path: Path, current_depth: int) -> Dict[str, Any]:
        structure: Dict[str, Any] = {}
        if current_depth > max_depth:
            return "..."

        try:
            for item in current_path.iterdir():
                if item.is_dir():
                    structure[item.name] = _get_structure(item, current_depth + 1)
                elif item.is_file():
                    structure[item.name] = "file"
        except Exception as e:
            logging.warning(f"Could not list contents of {current_path}: {e}")
            return f"Error listing: {e}"
        return structure

    logging.info(f"Generating file structure for {case_path} up to depth {max_depth}.")
    file_structure = _get_structure(case_path, 1)
    return {
        "status": "success",
        "message": "File structure retrieved successfully.",
        "file_structure": file_structure
    }



