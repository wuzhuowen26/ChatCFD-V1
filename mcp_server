# --- Helper Functions ---

def _clean_text_for_pdf_extraction(text: str, page_number: int) -> str:
    """
    Performs multi-stage text cleaning on extracted PDF text.
    This function is adapted from the provided CFDCaseExtractor.clean_text method.

    Args:
        text (str): The raw text extracted from a PDF page.
        page_number (int): The page number from which the text was extracted.

    Returns:
        str: The cleaned text, with page metadata added.
    """
    # Stage 1: Merge hyphenated words broken by newline
    text = re.sub(r'(?<=\w)-\n(?=\w)', '', text)

    # Stage 2: Handle numbers and units broken by newline
    text = re.sub(r'\n(?=\d+\s*[A-Za-z]{1,3}\b)', ' ', text)

    # Stage 3: Remove isolated page numbers (lines containing only digits and whitespace)
    text = re.sub(r'^\s*\d+\s*$', '', text, flags=re.MULTILINE)

    # Stage 4: Compress excessive whitespace
    text = re.sub(r'\n{3,}', '\n\n', text)  # Multiple newlines compressed to two
    text = re.sub(r'[ \t]{2,}', ' ', text)    # Multiple spaces/tabs compressed to one

    # Stage 5: Filter out very short lines (often chart labels or noise)
    lines = [line.strip() for line in text.split('\n') if len(line.strip()) > 3]

    # Add page metadata
    return f"Page {page_number}:\n" + "\n".join(lines) if lines else ""


def _extract_boundary_names_from_polyMesh(case_path: Path) -> List[str]:
    """
    Extracts boundary names from the 'constant/polyMesh/boundary' file of an OpenFOAM case.

    Args:
        case_path (Path): The path to the OpenFOAM case directory.

    Returns:
        List[str]: A list of extracted boundary names. Returns an empty list if the file
                   does not exist or parsing fails.
    """
    boundary_file = case_path / "constant" / "polyMesh" / "boundary"
    if not boundary_file.exists():
        logging.warning(f"Boundary file not found: {boundary_file}")
        return []

    names = []
    try:
        with open(boundary_file, 'r', encoding='utf-8') as f:
            content = f.read()
            # 查找以非数字开头，后面可以跟数字、字母、下划线、短横线的单词
            # 后面紧跟着一个 '{'，并且 'type' 关键字在同一个块内
            found_patches = re.findall(r'^\s*([a-zA-Z_][a-zA-Z0-9_-]*)\s*\{\s*type\s+\w+;', content, re.MULTILINE)
            
            # 过滤掉 OpenFOAM 默认的内部或辅助补丁
            boundary_names = [name for name in found_patches if name not in ["defaultFaces", "defaultPatches"]]
            names = boundary_names
            logging.info(f"Extracted boundary names: {names}")
    except Exception as e:
        logging.error(f"Error extracting boundary names from {boundary_file}: {e}")
        return []
    return names

def _create_minimal_openfoam_case_structure(case_path: Path, solver_name: str = "fluentMeshToFoam", end_time: int = 1):
    """
    为 OpenFOAM 案例创建必要的目录和最简的 controlDict 文件。

    Args:
        case_path (Path): OpenFOAM 案例的根目录。
        solver_name (str): 模拟将使用的 OpenFOAM 求解器名称。
        end_time (int): 模拟的结束时间。
    """
    system_dir = case_path / "system"
    constant_dir = case_path / "constant"
    time_0_dir = case_path / "0"

    system_dir.mkdir(parents=True, exist_ok=True)
    constant_dir.mkdir(parents=True, exist_ok=True)
    time_0_dir.mkdir(parents=True, exist_ok=True)

    # Minimal controlDict content
    control_dict_content = f"""FoamFile
{{
    version       2.0;
    format        ascii;
    class         dictionary;
    location      "system";
    object        controlDict;
}}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     {solver_name};
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         {end_time};
deltaT          1;
writeControl    timeStep;
writeInterval   1;
purgeWrite      0;
writeFormat     ascii;
writePrecision  6;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

// ************************************************************************* //
"""
    (system_dir / "controlDict").write_text(control_dict_content)
    logging.info(f"已在 {case_path} 创建最简 OpenFOAM 案例结构，controlDict 中 application 为 '{solver_name}', endTime 为 {end_time}。")


