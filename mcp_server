class ManagedFileResult(TypedDict):
    """Result structure for manage_openfoam_case_files tool (for read operation)."""
    status: str
    message: str
    file_content: Optional[str]
    # For write/update operations, content will be None

class ManageFilesResult(TypedDict):
    """Result structure for manage_openfoam_case_files tool (for write/apply operations)."""
    status: str
    message: str
    case_path: Path
    modified_files_count: Optional[int] # Number of files written/updated

@mcp.tool()
def manage_openfoam_case_files(
    case_path: Path,
    action: Literal["read", "write", "update"], # Define allowed actions
    file_rel_path: Optional[str] = None, # For read/update on single file
    content: Optional[str] = None,       # For write/update on single file
    llm_modifications_json: Optional[str] = None # For batch write/update
) -> Any: # Returns ManagedFileResult or ManageFilesResult based on action
    """
    Manages OpenFOAM case files by performing read, write, or update operations.
    This tool consolidates `generate_and_write_openfoam_files`, `read_openfoam_case_file`,
    and `apply_openfoam_file_changes`.

    Args:
        case_path (Path): The root path of the OpenFOAM case directory.
        action (Literal["read", "write", "update"]): The operation to perform.
            - "read": Reads the content of a single file.
            - "write": Writes/overwrites content to a single file or a batch of files.
            - "update": Applies modifications (overwrites) to a batch of files.
                        Functionally similar to "write" when provided with llm_modifications_json.
        file_rel_path (Optional[str]): The relative path to the file for "read" or single "write" operations.
        content (Optional[str]): The content to write/overwrite for a single file operation.
        llm_modifications_json (Optional[str]): A JSON string from the LLM.
                                                 For "write"/"update" actions, keys are relative file paths
                                                 and values are the *full new content* for those files.

    Returns:
        Union[ManagedFileResult, ManageFilesResult]: A dictionary containing the status and message.
                                                    For "read", includes 'file_content'.
                                                    For "write"/"update", includes 'case_path' and 'modified_files_count'.
    """
    if not case_path.is_dir():
        logging.error(f"Case path '{case_path}' does not exist or is not a directory.")
        return {
            "status": "failure",
            "message": f"Case path '{case_path}' does not exist or is not a directory. Cannot perform file operations.",
            "case_path": case_path,
            "modified_files_count": 0 if action in ["write", "update"] else None,
            "file_content": None if action == "read" else None
        }

    try:
        if action == "read":
            if not file_rel_path:
                logging.error("file_rel_path is required for 'read' action.")
                return {
                    "status": "failure",
                    "message": "file_rel_path is required for 'read' action.",
                    "file_content": None
                }
            full_file_path = case_path / file_rel_path
            if not full_file_path.exists() or not full_file_path.is_file():
                logging.warning(f"File not found or not a file for read: {full_file_path}")
                return {
                    "status": "failure",
                    "message": f"File '{file_rel_path}' not found or is not a file at '{case_path}'.",
                    "file_content": None
                }
            with open(full_file_path, 'r', encoding='utf-8') as f:
                file_content = f.read()
            logging.info(f"Successfully read file: {full_file_path}")
            return {
                "status": "success",
                "message": f"File '{file_rel_path}' read successfully.",
                "file_content": file_content
            }

        elif action in ["write", "update"]:
            modifications: Dict[str, str] = {}
            if llm_modifications_json:
                modifications = json.loads(llm_modifications_json)
                if not isinstance(modifications, dict):
                    raise ValueError("Provided JSON for modifications is not a dictionary.")
            elif file_rel_path and content is not None:
                modifications[file_rel_path] = content
            else:
                logging.error("Either llm_modifications_json or (file_rel_path and content) must be provided for 'write'/'update' action.")
                return {
                    "status": "failure",
                    "message": "Missing parameters for file write/update operation.",
                    "case_path": case_path, "modified_files_count": 0
                }
            
            modified_count = 0
            for rel_path, new_content in modifications.items():
                full_file_path = case_path / rel_path
                full_file_path.parent.mkdir(parents=True, exist_ok=True)
                with open(full_file_path, 'w', encoding='utf-8') as f:
                    f.write(new_content)
                logging.debug(f"Wrote/Updated file: {full_file_path}")
                modified_count += 1
            
            if modified_count == 0 and modifications:
                 logging.warning("LLM provided modifications, but no changes were successfully applied.")
                 return {
                     "status": "warning",
                     "message": "LLM provided modifications, but no files were successfully modified. Check paths/permissions.",
                     "case_path": case_path, "modified_files_count": 0
                 }

            logging.info(f"Successfully {action}d {modified_count} file(s) in {case_path}.")
            return {
                "status": "success",
                "message": f"Successfully {action}d {modified_count} file(s) in {case_path}.",
                "case_path": case_path,
                "modified_files_count": modified_count
            }

        else:
            logging.error(f"Invalid action specified: {action}")
            return {
                "status": "failure",
                "message": f"Invalid action: {action}. Must be 'read', 'write', or 'update'.",
                "case_path": case_path, "modified_files_count": None, "file_content": None
            }

    except json.JSONDecodeError as e:
        logging.error(f"Invalid JSON format for modifications: {e}. Original snippet: {llm_modifications_json[:500] if llm_modifications_json else 'N/A'}...")
        return {
            "status": "failure",
            "message": f"Input JSON for modifications is malformed: {e}.",
            "case_path": case_path, "modified_files_count": 0
        }
    except Exception as e:
        logging.exception(f"An unexpected error occurred during file management for {case_path} with action {action}.")
        return {
            "status": "failure",
            "message": f"An unknown error occurred during file management: {e}",
            "case_path": case_path, "modified_files_count": 0
        }



### `run_openfoam_simulation`

class SimulationResult(TypedDict):
    """Result structure for RunOpenFOAMSimulation tool."""
    status: str
    message: str
    case_path: Path
    log_file_path: Path
    full_log_content: str

@mcp.tool()
def run_openfoam_simulation(
    case_path: Path,
    solver_name: str,
    max_runtime_seconds: int = 1800
) -> SimulationResult:
    """
    Executes an OpenFOAM solver for a specified case and captures the run log.
    It also cleans up previous time step directories before running.

    Args:
        case_path (Path): The path to the OpenFOAM case directory.
        solver_name (str): The name of the OpenFOAM solver to run (e.g., 'simpleFoam', 'pimpleFoam').
        max_runtime_seconds (int): Maximum time in seconds to allow the solver to run
                                   before timing out. Defaults to 1800 seconds (30 minutes).

    Returns:
        SimulationResult: A dictionary containing the simulation status, a message,
                          the path to the case, the path to the log file, and the full log content.
    """
    log_file_path = case_path / "case_run.log"
    original_cwd = os.getcwd()

    try:
        if not case_path.is_dir():
            logging.error(f"Case path '{case_path}' does not exist or is not a directory.")
            return {
                "status": "failure",
                "message": f"Case path '{case_path}' does not exist or is not a directory.",
                "case_path": case_path, "log_file_path": Path(""), "full_log_content": ""
            }

        openfoam_path = os.environ.get("OPENFOAM_PATH")
        if not openfoam_path:
            logging.error("OPENFOAM_PATH environment variable is not set.")
            return {
                "status": "failure",
                "message": "OpenFOAM environment not initialized. OPENFOAM_PATH not found.",
                "case_path": case_path, "log_file_path": Path(""), "full_log_content": ""
            }

        for item in case_path.iterdir():
            if item.is_dir() and re.match(r"^\d+(\.\d+)?$", item.name) and item.name != '0':
                logging.info(f"Cleaning up old time step directory: {item}")
                shutil.rmtree(item)

        os.chdir(case_path)
        logging.info(f"Changed current directory to: {case_path}")

        command = f'source {openfoam_path}/etc/bashrc && {solver_name}'
        logging.info(f"Executing OpenFOAM solver command: {command}")

        full_log_content = ""
        with open(log_file_path, "w", encoding='utf-8') as log_f:
            process = subprocess.Popen(
                command,
                shell=True,
                executable="/usr/bin/bash",
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                bufsize=1
            )
            for line in process.stdout:
                sys.stdout.write(line)
                log_f.write(line)
                full_log_content += line
            process.stdout.close()
            process.wait(timeout=max_runtime_seconds)

        if process.returncode == 0:
            logging.info(f"Solver '{solver_name}' ran successfully. Log saved to {log_file_path}.")
            return {
                "status": "success",
                "message": f"Solver '{solver_name}' ran successfully, log saved to {log_file_path}.",
                "case_path": case_path, "log_file_path": log_file_path, "full_log_content": full_log_content
            }
        else:
            logging.error(f"Solver '{solver_name}' failed with exit code {process.returncode}. Log saved to {log_file_path}.")
            return {
                "status": "failure",
                "message": f"Solver '{solver_name}' failed, exit code: {process.returncode}, log saved to {log_file_path}.",
                "case_path": case_path, "log_file_path": log_file_path, "full_log_content": full_log_content
            }
    except subprocess.TimeoutExpired:
        if 'process' in locals() and process.poll() is None:
            process.kill()
            logging.warning(f"Killed timed-out solver process for '{solver_name}'.")
        logging.error(f"Solver '{solver_name}' timed out after {max_runtime_seconds} seconds. Log may be incomplete.")
        return {
            "status": "timeout",
            "message": f"Solver '{solver_name}' timed out ({max_runtime_seconds} seconds). Log may be incomplete.",
            "case_path": case_path, "log_file_path": log_file_path, "full_log_content": full_log_content
        }
    except Exception as e:
        logging.exception(f"An unexpected error occurred while running OpenFOAM simulation for {case_path}.")
        return {
            "status": "failure",
            "message": f"An unknown error occurred while running OpenFOAM case: {e}",
            "case_path": case_path, "log_file_path": log_file_path, "full_log_content": full_log_content
        }
    finally:
        if os.getcwd() != original_cwd:
            os.chdir(original_cwd)
            logging.info(f"Changed back to original directory: {original_cwd}")



