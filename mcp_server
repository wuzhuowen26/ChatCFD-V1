### `extract_pdf_text`

class PdfTextResult(TypedDict):
    """Result structure for extract_pdf_text tool."""
    status: str
    message: str
    extracted_text: str

@mcp.tool()
def extract_pdf_text(
    pdf_file_path: Path
) -> PdfTextResult:
    """
    Extracts and cleans text content from a PDF file. This tool is the first step
    in processing a research paper to extract CFD simulation conditions.

    Args:
        pdf_file_path (Path): The path to the input PDF file.

    Returns:
        PdfTextResult: A dictionary containing the extraction status,
                       a message, and the extracted text content.
    """
    if not pdf_file_path.exists():
        logging.error(f"PDF file not found: {pdf_file_path}")
        return {
            "status": "failure",
            "message": f"PDF file not found: {pdf_file_path}",
            "extracted_text": ""
        }
    if not pdf_file_path.is_file():
        logging.error(f"Provided path is not a file: {pdf_file_path}")
        return {
            "status": "failure",
            "message": f"Provided path is not a file: {pdf_file_path}",
            "extracted_text": ""
        }

    text_blocks = []
    try:
        logging.info(f"Starting PDF text extraction from: {pdf_file_path}")
        with pdfplumber.open(pdf_file_path) as pdf:
            for i, page in enumerate(pdf.pages):
                # Define effective text area (in points)
                bbox = (
                    50,  # left margin
                    50,  # top margin (skip header)
                    page.width - 50,  # right margin
                    page.height - 50  # bottom margin (skip footer)
                )

                # Create filter function to crop page content
                crop_filter = lambda obj: (
                    obj["x0"] >= bbox[0] and
                    obj["top"] >= bbox[1] and
                    obj["x1"] <= bbox[2] and
                    obj["bottom"] <= bbox[3]
                )

                # Apply area filtering
                cropped_page = page.filter(crop_filter)

                # Optimize text extraction parameters
                text = cropped_page.extract_text(
                    layout=True,
                    x_tolerance=3,
                    y_tolerance=2,
                    keep_blank_chars=False,
                    extra_attrs=["size", "fontname"]
                )

                # Clean text using the helper function
                cleaned_text = _clean_text_for_pdf_extraction(text, page_number=i + 1)
                if cleaned_text:
                    text_blocks.append(cleaned_text)
                logging.debug(f"Extracted and cleaned text from page {i+1}.")

        full_extracted_text = "\n".join(text_blocks)
        if not full_extracted_text.strip(): # Check if extracted text is empty after stripping whitespace
            logging.warning(f"No meaningful text extracted from {pdf_file_path}. The PDF might be image-based or heavily formatted.")
            return {
                "status": "partial_success",
                "message": "PDF processed, but no significant text content was extracted. It might be an image-only PDF.",
                "extracted_text": ""
            }
        logging.info(f"Successfully extracted text from {len(pdf.pages)} pages of {pdf_file_path}.")
        return {
            "status": "success",
            "message": "PDF text extracted successfully.",
            "extracted_text": full_extracted_text
        }
    except pdfplumber.PDFSyntaxError as e:
        logging.error(f"PDF syntax error in {pdf_file_path}: {e}")
        return {
            "status": "failure",
            "message": f"PDF syntax error: {e}. Please check the PDF file.",
            "extracted_text": ""
        }
    except Exception as e:
        logging.exception(f"An unexpected error occurred during PDF text extraction from {pdf_file_path}.")
        return {
            "status": "failure",
            "message": f"An unexpected error occurred during PDF text extraction: {e}",
            "extracted_text": ""
        }



### `parse_simulation_conditions`

class ParsedSimulationConditions(TypedDict):
    """Result structure for ParseSimulationConditions tool."""
    status: str
    message: str
    case_description: str
    solver: Optional[str]
    turbulence_model: Optional[str]
    physical_model: Optional[str]
    initial_conditions: Optional[Dict[str, Any]] # e.g., {"U": "(10 0 0)", "p": "0"}
    boundary_conditions: Optional[Dict[str, Any]] # e.g., {"inlet": {"U": "fixedValue", "p": "zeroGradient"}}
    dimensions: Optional[Dict[str, Any]] # e.g., {"x": "1m", "y": "0.1m"}
    numerical_schemes: Optional[Dict[str, Any]] # e.g., {"divSchemes": {"div(phi,U)": "Gauss linearUpwindV"}}
    control_parameters: Optional[Dict[str, Any]] # e.g., {"endTime": 100, "deltaT": 0.001}


@mcp.tool()
def parse_simulation_conditions(
    llm_sim_conditions_json: Dict[str, Any] # <--- 关键修改点1：输入类型改为字典
) -> ParsedSimulationConditions:
    """
    解析一个包含大型语言模型生成的模拟条件的 Python 字典，并将其以结构化格式返回。
    此工具直接处理结构化的 Python 字典。

    Args:
        llm_sim_conditions_json (Dict[str, Any]): 一个来自 LLM 的包含模拟条件的 Python 字典。
                                                  预期包含 'case_description', 'solver',
                                                  'turbulence_model', 'physical_model', 'initial_conditions',
                                                  'boundary_conditions', 'dimensions', 'numerical_schemes',
                                                  'control_parameters' 等键。

    Returns:
        ParsedSimulationConditions: 一个包含解析状态、消息和提取的模拟条件的字典。
    """
    try:
        # <--- 关键修改点2：移除 json.loads() 调用，直接使用传入的字典
        sim_conditions: Dict[str, Any] = llm_sim_conditions_json

        required_keys = ["case_description", "solver"]
        if not all(key in sim_conditions for key in required_keys):
            logging.warning(f"LLM simulation conditions JSON missing some recommended keys. Raw input: {sim_conditions}")
        
        logging.info("Successfully parsed simulation conditions from LLM.")
        return {
            "status": "success",
            "message": "Simulation conditions parsed successfully.",
            "case_description": sim_conditions.get("case_description", ""),
            "solver": sim_conditions.get("solver"),
            "turbulence_model": sim_conditions.get("turbulence_model"),
            "physical_model": sim_conditions.get("physical_model"),
            "initial_conditions": sim_conditions.get("initial_conditions"),
            "boundary_conditions": sim_conditions.get("boundary_conditions"),
            "dimensions": sim_conditions.get("dimensions"),
            "numerical_schemes": sim_conditions.get("numerical_schemes"),
            "control_parameters": sim_conditions.get("control_parameters")
        }
    except json.JSONDecodeError as e:
        logging.error(f"Invalid JSON format for LLM simulation conditions: {e}. Original: {llm_sim_conditions_json[:500]}...")
        return {
            "status": "failure",
            "message": f"Input LLM JSON is malformed: {e}. Original response snippet: {llm_sim_conditions_json[:500]}...",
            "case_description": "", "solver": None, "turbulence_model": None, "physical_model": None,
            "initial_conditions": None, "boundary_conditions": None, "dimensions": None,
            "numerical_schemes": None, "control_parameters": None
        }
    except Exception as e:
        logging.exception("An unexpected error occurred during simulation condition parsing.")
        return {
            "status": "failure",
            "message": f"An unexpected error occurred while parsing simulation conditions: {e}",
            "case_description": "", "solver": None, "turbulence_model": None, "physical_model": None,
            "initial_conditions": None, "boundary_conditions": None, "dimensions": None,
            "numerical_schemes": None, "control_parameters": None
        }



### `process_mesh_and_extract_boundaries`

class MeshProcessResult(TypedDict):
    """Result structure for process_mesh_and_extract_boundaries tool."""
    status: str
    message: str
    case_output_path: Path
    boundary_names: List[str]

@mcp.tool()
def process_mesh_and_extract_boundaries(
    msh_file_path: Path,
    output_base_path: Path,
    case_name: str,
    initial_solver_name: str = "fluentMeshToFoam",
    initial_end_time: int = 1
) -> MeshProcessResult:
    """
    Converts a Fluent mesh file (.msh) to OpenFOAM format and extracts
    the boundary names from the converted mesh. It also creates a minimal
    OpenFOAM case structure with a basic controlDict.

    Args:
        msh_file_path (Path): The path to the input Fluent mesh file.
        output_base_path (Path): The base directory where the OpenFOAM case will be created.
        case_name (str): The name of the OpenFOAM case directory to be created.
        initial_solver_name (str, optional): Initial 'application' field value in controlDict.
                                            Defaults to "fluentMeshToFoam".
        initial_end_time (int, optional): Initial 'endTime' field value in controlDict. Defaults to 1.

    Returns:
        MeshProcessResult: A dictionary containing the processing status,
                            a message, the path to the OpenFOAM case, and
                            a list of extracted boundary names.
    """
    case_output_path = output_base_path / case_name
    original_cwd = os.getcwd()

    try:
        if not msh_file_path.is_absolute():
            msh_file_path = msh_file_path.resolve()
            logging.info(f"Resolved MSH file path to: {msh_file_path}")

        if not msh_file_path.exists():
            logging.error(f"Mesh file not found: {msh_file_path}")
            return {
                "status": "failure",
                "message": f"Mesh file not found: {msh_file_path}",
                "case_output_path": Path(""), "boundary_names": []
            }
        if not msh_file_path.is_file():
            logging.error(f"Provided mesh path is not a file: {msh_file_path}")
            return {
                "status": "failure",
                "message": f"Provided mesh path is not a file: {msh_file_path}",
                "case_output_path": Path(""), "boundary_names": []
            }

        case_output_path.mkdir(parents=True, exist_ok=True)
        logging.info(f"Created case directory: {case_output_path}")

        openfoam_path = os.environ.get("OPENFOAM_PATH")
        if not openfoam_path:
            logging.error("OPENFOAM_PATH environment variable is not set.")
            return {
                "status": "failure",
                "message": "OpenFOAM environment not initialized. OPENFOAM_PATH not found.",
                "case_output_path": Path(""), "boundary_names": []
            }
            
        _create_minimal_openfoam_case_structure(case_output_path, initial_solver_name, initial_end_time)

        os.chdir(case_output_path)
        logging.info(f"Changed current directory to: {case_output_path}")

        command = f'source {openfoam_path}/etc/bashrc && fluentMeshToFoam "{msh_file_path.resolve()}"'
        logging.info(f"Executing mesh conversion command: {command}")

        process = subprocess.run(
            command,
            shell=True,
            executable="/usr/bin/bash",
            capture_output=True,
            text=True,
            check=False,
            timeout=600
        )

        if process.returncode != 0:
            logging.error(f"Mesh conversion failed. Stderr: {process.stderr}\nStdout: {process.stdout}")
            return {
                "status": "failure",
                "message": f"Mesh conversion failed: {process.stderr.strip()}",
                "case_output_path": case_output_path, "boundary_names": []
            }
        logging.info("Mesh conversion completed successfully.")
        logging.debug(f"fluentMeshToFoam Stdout: {process.stdout}")

        boundary_names = _extract_boundary_names_from_polyMesh(case_output_path)

        if not boundary_names:
            logging.warning("Mesh conversion successful, but no boundary names could be extracted. This might indicate an issue with the mesh or boundary file structure.")
            return {
                "status": "warning",
                "message": "Mesh conversion successful, but no boundary names could be extracted. Please check the mesh file structure.",
                "case_output_path": case_output_path, "boundary_names": []
            }

        logging.info("Mesh conversion and boundary name extraction successful.")
        return {
            "status": "success",
            "message": "Mesh conversion and boundary names extraction successful.",
            "case_output_path": case_output_path,
            "boundary_names": boundary_names
        }
    except subprocess.TimeoutExpired:
        logging.error(f"Mesh conversion timed out after {600} seconds for {msh_file_path}.")
        return {
            "status": "failure",
            "message": f"Mesh conversion timed out ({600} seconds).",
            "case_output_path": case_output_path, "boundary_names": []
        }
    except Exception as e:
        logging.exception(f"An unexpected error occurred during mesh processing for {msh_file_path}.")
        return {
            "status": "failure",
            "message": f"An unknown error occurred during mesh processing: {e}",
            "case_output_path": case_output_path, "boundary_names": []
        }
    finally:
        if os.getcwd() != original_cwd:
            os.chdir(original_cwd)
            logging.info(f"Changed back to original directory: {original_cwd}")



### `retrieve_of_case_template`

class OFCaseTemplateResult(TypedDict):
    """Result structure for RetrieveOFCaseTemplate tool."""
    status: str
    message: str
    selected_template_case: Optional[str]
    template_files_content: Dict[str, str]
    all_filtered_alternatives: Dict[str, List[str]]

@mcp.tool()
def retrieve_of_case_template(
    llm_chosen_template_case_name: str,
    solver_name: str,
    turbulence_model_name: Optional[str],
    other_physics_model: Optional[str],
    of_case_data: Dict[str, Any],
    solver_req_path: Path,
    turbulence_req_path: Path,
) -> OFCaseTemplateResult:
    """
    Retrieves the necessary OpenFOAM configuration files for a given solver, turbulence model,
    and other physics models, potentially using a LLM-chosen reference case as a template.

    Args:
        llm_chosen_template_case_name (str): The name of the reference OpenFOAM case
                                            chosen by an LLM as the best template.
        solver_name (str): The OpenFOAM solver name (e.g., 'pimpleFoam').
        turbulence_model_name (Optional[str]): The turbulence model name (e.g., 'kOmegaSST').
        other_physics_model (Optional[str]): Additional physical model (e.g., 'Maxwell').
        of_case_data (Dict[str, Any]): Loaded JSON data of OpenFOAM reference cases.
        solver_req_path (Path): Path to JSON file defining solver-specific file requirements.
        turbulence_req_path (Path): Path to JSON file defining turbulence model-specific file requirements.

    Returns:
        OFCaseTemplateResult: A dictionary with the status, message, selected template case name,
                              and the content of the template files.
    """
    initial_required_files_set = set()

    try:
        with open(solver_req_path, 'r', encoding='utf-8') as f:
            solver_requirements = json.load(f)
        if solver_name in solver_requirements:
            initial_required_files_set.update(solver_requirements[solver_name])
        else:
            logging.warning(f"Solver '{solver_name}' not found in {solver_req_path}.")
    except (FileNotFoundError, json.JSONDecodeError) as e:
        logging.error(f"Error loading solver requirements from {solver_req_path}: {e}")
        return {
            "status": "failure",
            "message": f"Failed to load solver requirements: {e}",
            "selected_template_case": None,
            "template_files_content": {},
            "all_filtered_alternatives": {}
        }

    if turbulence_model_name and turbulence_model_name != "laminar":
        try:
            with open(turbulence_req_path, 'r', encoding='utf-8') as f:
                turbulence_requirements = json.load(f)
            if turbulence_model_name in turbulence_requirements:
                initial_required_files_set.update(turbulence_requirements[turbulence_model_name])
            else:
                logging.warning(f"Turbulence model '{turbulence_model_name}' not found in {turbulence_req_path}.")
        except (FileNotFoundError, json.JSONDecodeError) as e:
            logging.error(f"Error loading turbulence requirements from {turbulence_req_path}: {e}")
            return {
                "status": "failure",
                "message": f"Failed to load turbulence requirements: {e}",
                "selected_template_case": None,
                "template_files_content": {},
                "all_filtered_alternatives": {}
            }

    if solver_name == "reactingFoam" and other_physics_model and "GRI" in other_physics_model:
        initial_required_files_set.add("constant/thermo.compressibleGasGRI")
        initial_required_files_set.add("constant/reactionsGRI")

    compressible_solvers = ["acousticFoam", "overRhoPimpleDyMFoam", "overRhoSimpleFoam", "rhoCentralFoam", "rhoPimpleAdiabaticFoam", "rhoPimpleFoam", "rhoPorousSimpleFoam", "rhoSimpleFoam", "sonicDyMFoam", "sonicFoam", "sonicLiquidFoam"]
    if solver_name in compressible_solvers and turbulence_model_name and turbulence_model_name != "laminar":
        initial_required_files_set.add("0/alphat")

    file_alternative: Dict[str, List[str]] = {}
    file_necessary_system = ["system/fvSolution", "system/controlDict", "system/fvSchemes", "system/FOBilgerMixtureFraction"]

    for key, value in of_case_data.items():
        case_solver = value.get("solver")
        case_turbulence_model = value.get("turbulence_model")
        case_other_physical_model = value.get("other_physical_model")

        if (case_solver == solver_name and
            (case_turbulence_model == turbulence_model_name or (turbulence_model_name is None and case_turbulence_model is None)) and
            (case_other_physical_model == other_physics_model or (other_physics_model is None and case_other_physical_model is None))):
            
            file_filtered = []
            for file_path in value.get("configuration_files", {}).keys():
                if file_path:
                    if file_path.startswith("system/"):
                        if file_path in file_necessary_system:
                            file_filtered.append(file_path)
                    else:
                        file_filtered.append(file_path)
            case_name_only = key.split("/")[-1]
            file_alternative[case_name_only] = file_filtered
    
    if not file_alternative:
        logging.warning("No strict matching reference case found. Falling back to matching by solver only.")
        for key, value in of_case_data.items():
            case_solver = value.get("solver")
            if case_solver == solver_name:
                file_filtered = []
                for file_path in value.get("configuration_files", {}).keys():
                    if file_path:
                        if file_path.startswith("system/"):
                            if file_path in file_necessary_system:
                                file_filtered.append(file_path)
                        else:
                            file_filtered.append(file_path)
                case_name_only = key.split("/")[-1]
                file_alternative[case_name_only] = file_filtered

    if not file_alternative:
        logging.error(f"No suitable reference cases found for solver '{solver_name}', turbulence '{turbulence_model_name}', other model '{other_physics_model}'.")
        return {
            "status": "failure",
            "message": "No suitable reference OpenFOAM cases found in the database.",
            "selected_template_case": None,
            "template_files_content": {},
            "all_filtered_alternatives": file_alternative
        }
    
    if llm_chosen_template_case_name not in file_alternative:
        logging.warning(f"LLM chosen template '{llm_chosen_template_case_name}' not found in filtered alternatives. Attempting to use a fallback from available alternatives.")
        if file_alternative:
            selected_case_name = list(file_alternative.keys())[0]
            logging.warning(f"Using '{selected_case_name}' as a fallback template case.")
        else:
            logging.error("No valid reference cases available after filtering.")
            return {
                "status": "failure",
                "message": "No valid reference cases available after filtering, and LLM's choice was invalid.",
                "selected_template_case": None,
                "template_files_content": {},
                "all_filtered_alternatives": file_alternative
            }
    else:
        selected_case_name = llm_chosen_template_case_name

    template_files_content: Dict[str, str] = {}
    found_case_data = None
    for key, value in of_case_data.items():
        if key.endswith(f"/{selected_case_name}"):
            found_case_data = value
            break
    
    if found_case_data:
        for file_rel_path in file_alternative.get(selected_case_name, []):
            if file_rel_path in found_case_data.get("configuration_files", {}):
                template_files_content[file_rel_path] = found_case_data["configuration_files"][file_rel_path]
            else:
                logging.warning(f"File '{file_rel_path}' specified for '{selected_case_name}' not found in its configuration_files data.")
        
        for required_file in initial_required_files_set:
            if required_file not in template_files_content:
                logging.warning(f"Required file '{required_file}' not found in the selected template '{selected_case_name}'. Agent needs to address this.")
                template_files_content[required_file] = "// Placeholder or missing content. Agent needs to generate or find this."

    else:
        logging.error(f"Could not find full data for selected case '{selected_case_name}' in OF_case_data.")
        return {
            "status": "failure",
            "message": f"Could not find full data for selected template case '{selected_case_name}'.",
            "selected_template_case": None,
            "template_files_content": {},
            "all_filtered_alternatives": file_alternative
        }

    logging.info(f"Successfully retrieved template files for '{selected_case_name}'.")
    return {
        "status": "success",
        "message": f"Successfully retrieved template files for '{selected_case_name}'.",
        "selected_template_case": selected_case_name,
        "template_files_content": template_files_content,
