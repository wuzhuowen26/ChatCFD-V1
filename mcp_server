class PdfTextResult(TypedDict):
    """Result structure for extract_pdf_text tool."""
    status: str
    message: str
    extracted_text: str

@mcp.tool()
def extract_pdf_text(
    pdf_file_path: Path
) -> PdfTextResult:
    """
    Extracts and cleans text content from a PDF file.

    Args:
        pdf_file_path (Path): The path to the input PDF file.

    Returns:
        PdfTextResult: A dictionary containing the extraction status,
                       a message, and the extracted text content.
    """
    if not pdf_file_path.exists():
        logging.error(f"PDF file not found: {pdf_file_path}")
        return {
            "status": "failure",
            "message": f"PDF file not found: {pdf_file_path}",
            "extracted_text": ""
        }
    if not pdf_file_path.is_file():
        logging.error(f"Provided path is not a file: {pdf_file_path}")
        return {
            "status": "failure",
            "message": f"Provided path is not a file: {pdf_file_path}",
            "extracted_text": ""
        }

    text_blocks = []
    try:
        logging.info(f"Starting PDF text extraction from: {pdf_file_path}")
        with pdfplumber.open(pdf_file_path) as pdf:
            for i, page in enumerate(pdf.pages):
                # Define effective text area (in points)
                bbox = (
                    50,  # left margin
                    50,  # top margin (skip header)
                    page.width - 50,  # right margin
                    page.height - 50  # bottom margin (skip footer)
                )

                # Create filter function to crop page content
                crop_filter = lambda obj: (
                    obj["x0"] >= bbox[0] and
                    obj["top"] >= bbox[1] and
                    obj["x1"] <= bbox[2] and
                    obj["bottom"] <= bbox[3]
                )

                # Apply area filtering
                cropped_page = page.filter(crop_filter)

                # Optimize text extraction parameters
                text = cropped_page.extract_text(
                    layout=True,
                    x_tolerance=3,
                    y_tolerance=2,
                    keep_blank_chars=False,
                    extra_attrs=["size", "fontname"]
                )

                # Clean text using the helper function
                cleaned_text = _clean_text_for_pdf_extraction(text, page_number=i + 1)
                if cleaned_text:
                    text_blocks.append(cleaned_text)
                logging.debug(f"Extracted and cleaned text from page {i+1}.")

        full_extracted_text = "\n".join(text_blocks)
        logging.info(f"Successfully extracted text from {len(pdf.pages)} pages of {pdf_file_path}.")
        return {
            "status": "success",
            "message": "PDF text extracted successfully.",
            "extracted_text": full_extracted_text
        }
    except pdfplumber.PDFSyntaxError as e:
        logging.error(f"PDF syntax error in {pdf_file_path}: {e}")
        return {
            "status": "failure",
            "message": f"PDF syntax error: {e}. Please check the PDF file.",
            "extracted_text": ""
        }
    except Exception as e:
        logging.exception(f"An unexpected error occurred during PDF text extraction from {pdf_file_path}.")
        return {
            "status": "failure",
            "message": f"An unexpected error occurred during PDF text extraction: {e}",
            "extracted_text": ""
        }




### `ExtractSimulationConditions`

class SimulationConditionsResult(TypedDict):
    """Result structure for extract_simulation_conditions tool."""
    status: str
    message: str
    case_description: str
    solver: str
    turbulence_model: Optional[str]
    physical_model: Optional[str]

@mcp.tool()
def extract_simulation_conditions(
    llm_sim_conditions_json: str
) -> SimulationConditionsResult:
    """
    Parses a JSON string containing simulation conditions generated by a large language model
    and returns them in a structured format.

    Args:
        llm_sim_conditions_json (str): A JSON string from the LLM containing simulation conditions.

    Returns:
        SimulationConditionsResult: A dictionary containing the parsing status,
                                    a message, and the extracted simulation conditions.
    """
    try:
        sim_conditions = json.loads(llm_sim_conditions_json)

        required_keys = ["case_description", "solver"]
        if not all(key in sim_conditions for key in required_keys):
            logging.error(f"LLM simulation conditions JSON missing required keys: {sim_conditions}")
            return {
                "status": "failure",
                "message": f"LLM returned simulation conditions JSON is missing required keys or malformed: {sim_conditions}",
                "case_description": "", "solver": "", "turbulence_model": None, "physical_model": None
            }

        logging.info("Successfully parsed simulation conditions from LLM.")
        return {
            "status": "success",
            "message": "Simulation conditions parsed successfully.",
            "case_description": sim_conditions.get("case_description", ""),
            "solver": sim_conditions.get("solver", ""),
            "turbulence_model": sim_conditions.get("turbulence_model"),
            "physical_model": sim_conditions.get("physical_model")
        }
    except json.JSONDecodeError as e:
        logging.error(f"Invalid JSON format for LLM simulation conditions: {e}. Original: {llm_sim_conditions_json[:500]}...")
        return {
            "status": "failure",
            "message": f"Input LLM JSON is malformed: {e}. Original response snippet: {llm_sim_conditions_json[:500]}...",
            "case_description": "", "solver": "", "turbulence_model": None, "physical_model": None
        }
    except Exception as e:
        logging.exception("An unexpected error occurred during simulation condition parsing.")
        return {
            "status": "failure",
            "message": f"An unexpected error occurred while parsing simulation conditions: {e}",
            "case_description": "", "solver": "", "turbulence_model": None, "physical_model": None
        }




### `ProcessMeshAndExtractBoundaries`

class MeshProcessResult(TypedDict):
    """Result structure for process_mesh_and_extract_boundaries tool."""
    status: str
    message: str
    case_output_path: Path
    boundary_names: List[str]

@mcp.tool()
def process_mesh_and_extract_boundaries(
    msh_file_path: Path,
    output_base_path: Path,
    case_name: str,
    # 增加可选参数，用于在网格处理阶段就初始化 controlDict
    # 默认值是为了让它在没有LLM信息时也能工作，但推荐实际传入
    initial_solver_name: str = "fluentMeshToFoam", # 默认用于网格转换的 application
    initial_end_time: int = 1 # 默认值，可在后续通过LLM信息更新
) -> MeshProcessResult:
    """
    Converts a Fluent mesh file (.msh) to OpenFOAM format and extracts
    the boundary names from the converted mesh.

    Args:
        msh_file_path (Path): The path to the input Fluent mesh file.
        output_base_path (Path): The base directory where the OpenFOAM case will be created.
        case_name (str): The name of the OpenFOAM case directory to be created.
        initial_solver_name (str, optional): controlDict 中 'application' 字段的初始值。
                                            通常在网格转换阶段为 "fluentMeshToFoam"，
                                            后续会由LLM根据模拟需求更新为实际求解器。
                                            默认为 "fluentMeshToFoam"。
        initial_end_time (int, optional): controlDict 中 'endTime' 字段的初始值。
                                         后续会由LLM根据模拟需求更新。默认为 1。

    Returns:
        MeshProcessResult: A dictionary containing the processing status,
                           a message, the path to the OpenFOAM case, and
                           a list of extracted boundary names.
    """
    case_output_path = output_base_path / case_name
    original_cwd = os.getcwd()

    try:
        # Input validation
        if not msh_file_path.is_absolute():
            # Convert to absolute path if not already
            msh_file_path = msh_file_path.resolve()
            logging.info(f"Resolved MSH file path to: {msh_file_path}")

        if not msh_file_path.exists():
            logging.error(f"Mesh file not found: {msh_file_path}")
            return {
                "status": "failure",
                "message": f"Mesh file not found: {msh_file_path}",
                "case_output_path": Path(""), "boundary_names": []
            }
        if not msh_file_path.is_file():
            logging.error(f"Provided mesh path is not a file: {msh_file_path}")
            return {
                "status": "failure",
                "message": f"Provided mesh path is not a file: {msh_file_path}",
                "case_output_path": Path(""), "boundary_names": []
            }

        case_output_path.mkdir(parents=True, exist_ok=True)
        logging.info(f"Created case directory: {case_output_path}")

        openfoam_path = os.environ.get("OPENFOAM_PATH")
        if not openfoam_path:
            logging.error("OPENFOAM_PATH environment variable is not set.")
            return {
                "status": "failure",
                "message": "OpenFOAM environment not initialized. OPENFOAM_PATH not found.",
                "case_output_path": Path(""), "boundary_names": []
            }
        
        # 调用改造后的辅助函数，传入初始求解器名称和结束时间
        _create_minimal_openfoam_case_structure(case_output_path, initial_solver_name, initial_end_time)

        os.chdir(case_output_path)
        logging.info(f"Changed current directory to: {case_output_path}")

        # Adding source command for OpenFOAM environment
        command = f'source {openfoam_path}/etc/bashrc && fluentMeshToFoam "{msh_file_path.resolve()}"'
        logging.info(f"Executing mesh conversion command: {command}")

        process = subprocess.run(
            command,
            shell=True,
            executable="/usr/bin/bash", # Explicitly use bash for sourcing
            capture_output=True,
            text=True,
            check=False,
            timeout=600 # Increased timeout for mesh conversion
        )

        if process.returncode != 0:
            logging.error(f"Mesh conversion failed. Stderr: {process.stderr}\nStdout: {process.stdout}")
            return {
                "status": "failure",
                "message": f"Mesh conversion failed: {process.stderr.strip()}",
                "case_output_path": case_output_path, "boundary_names": []
            }
        logging.info("Mesh conversion completed successfully.")
        logging.debug(f"fluentMeshToFoam Stdout: {process.stdout}")

        # 这里的 _extract_boundary_names_from_polyMesh 已经使用了新的、更健壮的正则表达式
        boundary_names = _extract_boundary_names_from_polyMesh(case_output_path)

        if not boundary_names:
            logging.warning("Mesh conversion successful, but no boundary names could be extracted.")
            # 将此处的返回状态从 "failure" 改为 "partial_success" 或保持 "success"
            # 具体取决于你希望这种情况下如何报告给上层代理
            # 这里我保持为 "failure"，因为无法获取边界名称通常是一个关键问题
            return {
                "status": "failure",
                "message": "Mesh conversion successful, but failed to extract boundary names. Please check the mesh file structure.",
                "case_output_path": case_output_path, "boundary_names": []
            }

        logging.info("Mesh conversion and boundary name extraction successful.")
        return {
            "status": "success",
            "message": "Mesh conversion and boundary names extraction successful.",
            "case_output_path": case_output_path,
            "boundary_names": boundary_names
        }
    except subprocess.TimeoutExpired:
        logging.error(f"Mesh conversion timed out after {600} seconds for {msh_file_path}.")
        return {
            "status": "failure",
            "message": f"Mesh conversion timed out ({msh_file_path}).",
            "case_output_path": case_output_path, "boundary_names": []
        }
    except Exception as e:
        logging.exception(f"An unexpected error occurred during mesh processing for {msh_file_path}.")
        return {
            "status": "failure",
            "message": f"An unknown error occurred during mesh processing: {e}",
            "case_output_path": case_output_path, "boundary_names": []
        }
    finally:
        # Always change back to the original working directory
        if os.getcwd() != original_cwd:
            os.chdir(original_cwd)
            logging.info(f"Changed back to original directory: {original_cwd}")




### `GenerateOpenFOAMCaseFiles`

class GeneratedFilesResult(TypedDict):
    """Result structure for generate_openfoam_case_files tool."""
    status: str
    message: str
    case_path: Path

@mcp.tool()
def generate_openfoam_case_files(
    case_path: str,
    llm_boundary_types_json: str,
    llm_ic_bc_data_json: str,
    llm_case_files_content_json: str,
    create_mesh: Optional[bool] = True,
    mesh_generation_method: Optional[str] = "blockMesh"
) -> Dict[str, Any]:
    """
    Generates OpenFOAM case files (constant, system, 0) based on LLM-provided JSON data.
    This tool handles the full case setup, including boundary types, initial/boundary conditions,
    and the content of key system and constant files.

    Args:
        case_path (str): The absolute path to the desired OpenFOAM case directory.
                         Example: '/personal/OpenFOAM_Cases/myCase'
        llm_boundary_types_json (str): A JSON string defining the boundary types
                                       for mesh patches. Example:
                                       '{"inlet": "patch", "outlet": "patch"}'
        llm_ic_bc_data_json (str): A JSON string defining initial and boundary conditions
                                   for fields like U and p. Example:
                                   '{"initial_conditions": {"U": [0,0,0]}, "boundary_conditions": {"inlet": {"type": "fixedValue", "U": [1,0,0]}}}'
        llm_case_files_content_json (str): A JSON string where keys are file paths
                                           (e.g., "system/controlDict") and values are
                                           the exact string content for those files.
                                           Example: '{"system/controlDict": "FoamFile\\n{...}"}'
        create_mesh (bool): If True, the tool will attempt to create the mesh (default: True).
        mesh_generation_method (str): The method to use for mesh generation (e.g., "blockMesh", "snappyHexMesh").
                                      Only "blockMesh" is fully supported for automatic generation currently.
                                      (default: "blockMesh")

    Returns:
        Dict[str, Any]: A dictionary containing the status ("success" or "failure")
                        and a message. If successful, includes "case_path".
    """
    logging.info(f"Received request to generate OpenFOAM case files at: {case_path}")

    # --- START OF MODIFICATION ---
    def extract_pure_json_string(raw_input_str: str) -> str:
        # 使用正则表达式匹配 JSON 对象或数组，并去除围绕它的 Python 字符串字面量相关内容
        # pattern = r'^\s*\"*\"*\"*\s*(\{.*\}|\[.*\])\s*\"*\"*\"*\s*$'
        # 考虑到 MCP Inspector 的行为，最直接的方式是找到第一个 { 并匹配到最后一个 }
        # 或者找到第一个 [ 并匹配到最后一个 ]
        
        # 尝试匹配以 { 或 [ 开头，并以 } 或 ] 结尾的 JSON 结构
        match = re.search(r'\{.*\}|\[.*\]', raw_input_str, re.DOTALL)
        if match:
            # 找到匹配的纯 JSON 字符串
            return match.group(0)
        else:
            # 如果没有找到 JSON 结构，可能是纯文本，或者格式完全不对，直接返回原始字符串（后面json.loads会报错）
            # 或者抛出更具体的错误
            raise ValueError("无法从输入字符串中提取有效的 JSON 结构。请确保输入包含一个完整的 JSON 对象或数组。")

    try:
        # 清理并提取纯 JSON 字符串
        clean_llm_boundary_types_json = extract_pure_json_string(llm_boundary_types_json)
        clean_llm_ic_bc_data_json = extract_pure_json_string(llm_ic_bc_data_json)
        clean_llm_case_files_content_json = extract_pure_json_string(llm_case_files_content_json)

        # 现在解析内容 JSON
        case_files_content = json.loads(clean_llm_case_files_content_json)
        ic_bc_data = json.loads(clean_llm_ic_bc_data_json)
        boundary_types = json.loads(clean_llm_boundary_types_json)
    except (json.JSONDecodeError, ValueError) as e:
        # 在错误消息中包含导致问题的具体字符串片段
        return {"status": "failure", "message": f"输入 LLM JSON 格式错误或无法提取：{e}。请检查输入 JSON 字符串。受影响的输入字符串（可能包含多余的引号和换行）：\nBoundary Types:\n{llm_boundary_types_json[:200]}...\nIC/BC Data:\n{llm_ic_bc_data_json[:200]}...\nCase Files Content:\n{llm_case_files_content_json[:200]}..."}
    except Exception as e:
        return {"status": "failure", "message": f"处理 LLM JSON 时发生意外错误：{e}"}
    # --- END OF MODIFICATION ---

    # 原始逻辑（函数其余部分）
    case_path_obj = Path(case_path)
    
    # 确保案例路径存在
    try:
        case_path_obj.mkdir(parents=True, exist_ok=True)
    except Exception as e:
        return {"status": "failure", "message": f"无法创建案例目录 {case_path}: {e}"}

    # 根据解析后的 JSON 内容写入文件
    try:
        for file_path_str, content in case_files_content.items():
            full_file_path = case_path_obj / file_path_str
            full_file_path.parent.mkdir(parents=True, exist_ok=True) # 确保子目录存在
            with open(full_file_path, "w") as f:
                f.write(content)

        # 示例：根据 boundary_types 创建 constant/polyMesh/boundary 文件
        # 这是一个简化的示例，你需要根据实际需求构建此文件
        boundary_file_path = case_path_obj / "constant/polyMesh/boundary"
        boundary_file_path.parent.mkdir(parents=True, exist_ok=True)
        with open(boundary_file_path, "w") as f:
            f.write("FoamFile\n{\n    version     2.0;\n    format      ascii;\n    class       dictionary;\n    object      boundary;\n}\n\n")
            f.write(f"nFaces {len(boundary_types)};\n\n") # This is a placeholder, actual faces count depends on mesh
            f.write("boundary\n(\n")
            for name, type_val in boundary_types.items():
                f.write(f"    {name}\n    {{\n        type            {type_val};\n        nFaces          0; // Placeholder\n        startFace       0; // Placeholder\n    }}\n")
            f.write(");\n")

        # 示例：根据 ic_bc_data 创建 0/U 和 0/p 文件
        # 这也需要更详细的逻辑来构建完整的 OpenFOAM 场文件
        # For 'U'
        u_file_path = case_path_obj / "0/U"
        u_file_path.parent.mkdir(parents=True, exist_ok=True)
        with open(u_file_path, "w") as f:
            f.write("FoamFile\n{\n    version     2.0;\n    format      ascii;\n    class       volVectorField;\n    object      U;\n}\n")
            f.write("dimensions      [0 1 -1 0 0 0 0];\n")
            initial_u = ic_bc_data["initial_conditions"]["U"]
            f.write(f"internalField   uniform ({initial_u[0]} {initial_u[1]} {initial_u[2]});\n")
            f.write("boundaryField\n{\n")
            for patch_name, bc in ic_bc_data["boundary_conditions"].items():
                if "U" in bc:
                    value_str = ""
                    if isinstance(bc["U"], list):
                        value_str = f"uniform ({bc['U'][0]} {bc['U'][1]} {bc['U'][2]})"
                    else:
                        value_str = bc["U"] # e.g., "zeroGradient"
                    f.write(f"    {patch_name}\n    {{\n        type            {bc['type']};\n        value           {value_str};\n    }}\n")
            f.write("}\n")

        # For 'p'
        p_file_path = case_path_obj / "0/p"
        p_file_path.parent.mkdir(parents=True, exist_ok=True)
        with open(p_file_path, "w") as f:
            f.write("FoamFile\n{\n    version     2.0;\n    format      ascii;\n    class       volScalarField;\n    object      p;\n}\n")
            f.write("dimensions      [0 2 -2 0 0 0 0];\n")
            initial_p = ic_bc_data["initial_conditions"]["p"]
            f.write(f"internalField   uniform {initial_p};\n")
            f.write("boundaryField\n{\n")
            for patch_name, bc in ic_bc_data["boundary_conditions"].items():
                if "p" in bc:
                    value_str = bc["p"] # e.g., 0 or "zeroGradient"
                    if isinstance(value_str, (int, float)):
                        value_str = f"uniform {value_str}"
                    f.write(f"    {patch_name}\n    {{\n        type            {bc['type']};\n        value           {value_str};\n    }}\n")
            f.write("}\n")

    except Exception as e:
        logging.error(f"创建案例文件时出错: {e}")
        return {"status": "failure", "message": f"创建案例文件时出错: {e}"}

    # 创建网格（如果需要）
    if create_mesh:
        if mesh_generation_method == "blockMesh":
            blockmesh_log_path = case_path_obj / "log.blockMesh"
            logging.info(f"正在运行 blockMesh 在 {case_path}...")
            try:
                # 切换到案例目录并运行 blockMesh
                subprocess.run(
                    ["blockMesh"],
                    cwd=case_path_obj,
                    check=True,
                    capture_output=True,
                    text=True
                )
                logging.info(f"blockMesh 成功运行。")
            except subprocess.CalledProcessError as e:
                logging.error(f"blockMesh 失败，退出码: {e.returncode}, 错误: {e.stderr}")
                return {"status": "failure", "message": f"blockMesh 失败，退出码: {e.returncode}, 错误日志:\n{e.stderr}", "log": e.stderr}
            except Exception as e:
                logging.error(f"运行 blockMesh 时出错: {e}")
                return {"status": "failure", "message": f"运行 blockMesh 时出错: {e}"}
        else:
            logging.warning(f"不支持的网格生成方法: {mesh_generation_method}. 跳过网格生成。")
            return {"status": "failure", "message": f"不支持的网格生成方法: {mesh_generation_method}. 请使用 'blockMesh'."}
    
    logging.info(f"OpenFOAM 案例文件已成功生成在：{case_path}")
    return {"status": "success", "message": "OpenFOAM 案例文件已成功生成。", "case_path": case_path}


### `RunOpenFOAMSimulation`

class SimulationResult(TypedDict):
    """Result structure for run_openfoam_simulation tool."""
    status: str
    message: str
    case_path: Path
    log_file_path: Path

@mcp.tool()
def run_openfoam_simulation(
    case_path: Path,
    solver_name: str,
    max_runtime_seconds: int = 600
) -> SimulationResult:
    """
    Executes an OpenFOAM solver for a specified case and captures the run log.

    Args:
        case_path (Path): The path to the OpenFOAM case directory.
        solver_name (str): The name of the OpenFOAM solver to run (e.g., 'simpleFoam').
        max_runtime_seconds (int): Maximum time in seconds to allow the solver to run
                                   before timing out. Defaults to 600 seconds (10 minutes).

    Returns:
        SimulationResult: A dictionary containing the simulation status, a message,
                          the path to the case, and the path to the log file.
    """
    log_file_path = case_path / "case_run.log"
    original_cwd = os.getcwd()

    try:
        if not case_path.is_dir():
            logging.error(f"Case path '{case_path}' does not exist or is not a directory.")
            return {
                "status": "failure",
                "message": f"Case path '{case_path}' does not exist or is not a directory.",
                "case_path": case_path, "log_file_path": Path("")
            }

        openfoam_path = os.environ.get("OPENFOAM_PATH")
        if not openfoam_path:
            logging.error("OPENFOAM_PATH environment variable is not set.")
            return {
                "status": "failure",
                "message": "OpenFOAM environment not initialized. OPENFOAM_PATH not found.",
                "case_path": case_path, "log_file_path": Path("")
            }

        # Clean up old time step directories to ensure a clean run
        for item in case_path.iterdir():
            # Matches directories named purely with numbers (e.g., '0', '100', '0.5')
            if item.is_dir() and re.match(r"^\d+(\.\d+)?$", item.name):
                logging.info(f"Cleaning up old time step directory: {item}")
                shutil.rmtree(item)

        os.chdir(case_path)
        logging.info(f"Changed current directory to: {case_path}")

        # Command to source OpenFOAM environment and run the solver
        command = f'source {openfoam_path}/etc/bashrc && {solver_name}'
        logging.info(f"Executing OpenFOAM solver command: {command}")

        with open(log_file_path, "w", encoding='utf-8') as log_f:
            process = subprocess.Popen(
                command,
                shell=True,
                executable="/usr/bin/bash",
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT, # Redirect stderr to stdout to capture all output in one log
                text=True,
                bufsize=1 # Line-buffered output
            )
            # Stream output to console and log file simultaneously
            for line in process.stdout:
                sys.stdout.write(line) # Print to console
                log_f.write(line)      # Write to log file
            process.stdout.close()
            process.wait(timeout=max_runtime_seconds) # Wait for process to complete or timeout

        if process.returncode == 0:
            logging.info(f"Solver '{solver_name}' ran successfully. Log saved to {log_file_path}.")
            return {
                "status": "success",
                "message": f"Solver '{solver_name}' ran successfully, log saved to {log_file_path}.",
                "case_path": case_path, "log_file_path": log_file_path
            }
        else:
            logging.error(f"Solver '{solver_name}' failed with exit code {process.returncode}. Log saved to {log_file_path}.")
            return {
                "status": "failure",
                "message": f"Solver '{solver_name}' failed, exit code: {process.returncode}, log saved to {log_file_path}.",
                "case_path": case_path, "log_file_path": log_file_path
            }
    except subprocess.TimeoutExpired:
        # If the process is still running, kill it
        if 'process' in locals() and process.poll() is None:
            process.kill()
            logging.warning(f"Killed timed-out solver process for '{solver_name}'.")
        logging.error(f"Solver '{solver_name}' timed out after {max_runtime_seconds} seconds. Log may be incomplete.")
        return {
            "status": "failure",
            "message": f"Solver '{solver_name}' timed out ({max_runtime_seconds} seconds). Log may be incomplete.",
            "case_path": case_path, "log_file_path": log_file_path
        }
    except Exception as e:
        logging.exception(f"An unexpected error occurred while running OpenFOAM simulation for {case_path}.")
        return {
            "status": "failure",
            "message": f"An unknown error occurred while running OpenFOAM case: {e}",
            "case_path": case_path, "log_file_path": log_file_path
        }
    finally:
        # Ensure we always change back to the original working directory
        if os.getcwd() != original_cwd:
            os.chdir(original_cwd)
            logging.info(f"Changed back to original directory: {original_cwd}")

