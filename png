import os
import subprocess
import pyvista as pv
import numpy as np
from pathlib import Path
import sys
import re # 导入正则表达式模块

def visualize_openfoam_velocity(case_path: Path, output_image_path: Path, time_step: str = "latest"):
    """
    自动调用 OpenFOAM 的 foamToVTK 工具，并将指定 OpenFOAM 案例的速度 U 场可视化为图片。

    Args:
        case_path (Path): OpenFOAM 案例的路径 (例如 Path("/path/to/your/case/myCylinderFlow")).
        output_image_path (Path): 输出图片文件的完整路径 (例如 Path("./velocity_magnitude.png")).
        time_step (str): 要可视化的时间步。可以是 "latest" (默认) 或具体的数字时间步字符串 (例如 "1000")。
                         如果指定 "latest"，脚本会尝试找到最新的时间步。
    """
    if not case_path.is_dir():
        print(f"错误: 案例路径 '{case_path}' 不存在或不是一个目录。")
        sys.exit(1)

    print(f"正在处理案例: {case_path}")
    print(f"目标输出图片: {output_image_path}")

    # 1. 运行 foamToVTK 将 OpenFOAM 结果转换为 VTK 格式
    print("正在运行 foamToVTK...")
    try:
        command = ["foamToVTK", "-latestTime" if time_step == "latest" else f"-time {time_step}"]
        
        result = subprocess.run(command, cwd=case_path, capture_output=True, text=True, check=True)
        print("foamToVTK 输出:")
        print(result.stdout)
        if result.stderr:
            print("foamToVTK 错误输出:")
            print(result.stderr)

    except subprocess.CalledProcessError as e:
        print(f"错误: foamToVTK 运行失败。请确保 OpenFOAM 环境已正确配置且案例路径正确。")
        print(f"命令: {' '.join(e.cmd)}")
        print(f"返回码: {e.returncode}")
        print(f"标准输出:\n{e.stdout}")
        print(f"标准错误:\n{e.stderr}")
        sys.exit(1)
    except FileNotFoundError:
        print("错误: 'foamToVTK' 命令未找到。请确保 OpenFOAM 环境已正确源化 (sourced)。")
        sys.exit(1)

    # 2. 确定 VTK 文件的路径
    vtk_output_dir = case_path / "VTK"
    case_name = case_path.name # 获取案例名称

    actual_time_step_dir = None
    if time_step == "latest":
        # 寻找符合 <案例名称>_<时间步> 或 <时间步> 格式的目录
        time_dirs_found = []
        for d in vtk_output_dir.iterdir():
            if d.is_dir():
                # 检查 <case_name>_<time_value> 格式 (例如: naca0012_case_1)
                match_case_time = re.match(rf"^{re.escape(case_name)}_(\d+\.?\d*)$", d.name)
                # 检查纯 <time_value> 格式 (例如: 1)
                match_time_only = re.match(r"^(\d+\.?\d*)$", d.name)

                if match_case_time:
                    time_dirs_found.append((float(match_case_time.group(1)), d))
                elif match_time_only:
                    time_dirs_found.append((float(match_time_only.group(1)), d))
        
        if time_dirs_found:
            # 按时间值排序 (降序) 以获取最新的时间步
            time_dirs_found.sort(key=lambda x: x[0], reverse=True)
            actual_time_step_dir = time_dirs_found[0][1]
            print(f"已找到最新的 VTK 时间步目录: {actual_time_step_dir.name}")
        else:
            print(f"错误: 在 '{vtk_output_dir}' 中未找到任何符合预期的 VTK 时间步目录。")
            print(f"预期目录名格式: '{case_name}_<时间步>' 或 '<时间步>'。")
            sys.exit(1)
    else:
        # 对于指定的时间步，尝试 <案例名称>_<时间步> 格式
        possible_dir_name = f"{case_name}_{time_step}"
        actual_time_step_dir = vtk_output_dir / possible_dir_name
        
        if not actual_time_step_dir.is_dir():
            # 如果未找到，再尝试纯数字时间步格式
            actual_time_step_dir = vtk_output_dir / time_step
            if not actual_time_step_dir.is_dir():
                print(f"错误: 指定时间步 '{time_step}' 的 VTK 目录 '{vtk_output_dir / possible_dir_name}' 或 '{vtk_output_dir / time_step}' 不存在。")
                sys.exit(1)

    # 寻找 VTK 文件 (通常是 .vtu 或 .vtk)
    # foamToVTK 通常会为内部网格输出 .vtu 文件
    vtk_file_pattern = "*.vtu" 
    vtk_files = list(actual_time_step_dir.glob(vtk_file_pattern))
    
    if not vtk_files:
        # 如果没有找到 .vtu，再尝试 .vtk (较少用于 foamToVTK 的内部网格数据)
        vtk_file_pattern = "*.vtk" 
        vtk_files = list(actual_time_step_dir.glob(vtk_file_pattern))

    if not vtk_files:
        print(f"错误: 在 '{actual_time_step_dir}' 中未找到任何 VTK 文件 ({vtk_file_pattern})。")
        sys.exit(1)

    # 通常只有一个 VTK 文件代表整个网格
    mesh_file = vtk_files[0]
    print(f"正在加载 VTK 文件: {mesh_file}")

    # 3. 使用 PyVista 加载数据
    try:
        mesh = pv.read(mesh_file)
    except Exception as e:
        print(f"错误: 使用 PyVista 读取 VTK 文件失败: {e}")
        sys.exit(1)

    # 4. 提取速度 U 场并计算速度大小
    if "U" not in mesh.point_data:
        print(f"错误: 在 VTK 数据中未找到 'U' 场。请确保 foamToVTK 导出了速度 U。")
        print(f"可用数据场: {list(mesh.point_data.keys())}") # 打印可用数据场以供调试
        sys.exit(1)

    velocity_u = mesh.point_data["U"]
    # 速度 U 是一个向量场 (Ux, Uy, Uz)，计算其大小
    velocity_magnitude = np.linalg.norm(velocity_u, axis=1)
    mesh["VelocityMagnitude"] = velocity_magnitude # 将计算结果添加到网格数据中

    print("已计算速度大小。")

    # 5. 可视化并保存图片
    print("正在生成可视化图片...")
    plotter = pv.Plotter(off_screen=True) # off_screen=True 允许在没有 GUI 的服务器上运行
    
    # 添加网格并使用 VelocityMagnitude 作为标量进行着色
    plotter.add_mesh(mesh, scalars="VelocityMagnitude", cmap="viridis", show_scalar_bar=True,
                     scalar_bar_args={'title': 'Velocity Magnitude', 'font_size': 16})
    
    # 尝试设置为 XY 平面视图，这对于 2D 模拟很常见
    plotter.view_xy() 
    plotter.camera.zoom(1.2) # 稍微放大以更好地查看

    # 确保输出目录存在
    output_image_path.parent.mkdir(parents=True, exist_ok=True) 
    # 保存图片，scale=2 提高分辨率
    plotter.screenshot(output_image_path, transparent_background=False, scale=2) 
    print(f"图片已成功保存到: {output_image_path}")

    plotter.close()

if __name__ == "__main__":
    # --- 示例用法 ---
    # 请根据你的实际情况修改以下路径！

    # 你的 OpenFOAM 案例的根路径
    # 根据你提供的报错信息，案例路径是 /personal/naca0012_case
    openfoam_case_root = Path("/personal/naca0012_case") # <-- 确认这是你的案例根路径

    # 输出图片的路径
    output_image_dir = Path("./visualization_output")
    output_image_dir.mkdir(exist_ok=True) # 确保输出目录存在
    output_image_file = output_image_dir / "velocity_magnitude_plot.png" # <--- 输出图片文件名

    # 调用可视化函数，time_step="latest" 应该能找到 naca0012_case_1
    visualize_openfoam_velocity(openfoam_case_root, output_image_file, time_step="latest")

    print("\n可视化脚本运行完毕。")
    print(f"请检查 '{output_image_file}' 以查看结果。")
